[Unit]
Description=deskbot exchange announcement collector (Binance, Upbit)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deskbot
WorkingDirectory=/opt/deskbot
ExecStart=/usr/bin/python3 research/announcements.py --quiet
TimeoutStartSec=600
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/deskbot/data
PrivateTmp=true
