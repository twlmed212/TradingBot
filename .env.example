# Copy to .env (git-ignored) and fill in. Check with: python3 tools/check_env.py (never prints values).
# Never put a wallet private key or seed phrase anywhere in this project: the product is non-custodial.

# Solana RPC (Helius). SOLANA_RPC_URL is the full URL including ?api-key=
HELIUS_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Jupiter API key from the Jupiter developer portal (optional for development: keyless works at lower limits)
JUPITER_API_KEY=

# Public address of our Jupiter referral account (create it at https://referral.jup.ag/ with the owner's wallet)
REFERRAL_ACCOUNT=
# Integrator fee in basis points, 50-255 (Jupiter keeps 20% of it)
FEE_BPS=50

# Telegram bot token from @BotFather (milestone 2). In production this lives in AWS SSM Parameter Store.
TELEGRAM_BOT_TOKEN=
