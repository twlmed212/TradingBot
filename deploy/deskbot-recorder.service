[Unit]
Description=deskbot Jupiter quote recorder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deskbot
WorkingDirectory=/opt/deskbot
ExecStart=/usr/bin/python3 recorder/quote_recorder.py --db data/quotes.sqlite3 --universe recorder/universe.json
Restart=always
RestartSec=10
# SIGTERM lets the recorder finish its current cycle before exiting
KillSignal=SIGTERM
TimeoutStopSec=90
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/deskbot/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
